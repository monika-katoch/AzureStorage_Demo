{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BlobStorage": {
    "BlobStorage": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "ContainerName": "demo-uploads",
      "MaxFileSizeBytes": 52428800,
      "SasExpiryMinutes": 15
    },
    "VideoStorage": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "ContainerName": "demo-videos",
      "MaxFileSizeBytes": 2147483648
    },
    "OrderPipeline": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "TableName": "OrdersTable",
      "QueueName": "order-processing-queue",
      "PoisonQueueName": "order-processing-queue-poison",
      "MaxDequeueCount": 5,
      "VisibilityTimeoutSeconds": 30
    }
  }
}