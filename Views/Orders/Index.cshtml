@model OrderPageViewModel
@{
    ViewData["Title"] = "Orders";
    var region = ViewData["Region"] as string;
    var regions = new[] { "US-East", "US-West", "EU", "APAC" };
    var processed = Model.Orders.Count(o => o.Status == "Processed");
    var pending = Model.Orders.Count - processed;
}

@if (TempData["Success"] is string ok) { <div class="alert ok">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert err">@err</div> }

<div class="tiles" style="margin-bottom:20px;">
    <div class="tile blue"><div class="n">@Model.Orders.Count</div><div class="l">Orders shown</div></div>
    <div class="tile amber"><div class="n">@pending</div><div class="l">Pending</div></div>
    <div class="tile green"><div class="n">@processed</div><div class="l">Processed</div></div>
    <div class="tile"><div class="n">@Model.ApproximateQueueDepth</div><div class="l">In queue</div></div>
</div>

<div class="card">
    <h2>Place an order</h2>
    <form asp-action="Create" asp-controller="Orders" method="post">
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <label>Region (PartitionKey)
                <select name="region" required>
                    @foreach (var r in regions) { <option value="@r">@r</option> }
                </select>
            </label>
            <label>Customer <input name="customerName" value="Acme Corp" /></label>
            <label>Product <input name="product" value="Widget" required /></label>
            <label>Quantity <input name="quantity" type="number" value="1" min="1" /></label>
            <label>Total ($) <input name="total" type="number" step="0.01" value="49.99" min="0" /></label>
        </div>
        <p style="margin-bottom:0;"><button type="submit" class="btn">Submit order</button></p>
    </form>
    <p class="muted">
        Persists to <code>OrdersTable</code> (PartitionKey = region, RowKey = GUID), enqueues on
        <code>@Model.QueueName</code>, and returns instantly. The background worker flips it to
        <strong>Processed</strong> — toggle auto-refresh below to watch it happen.
    </p>
</div>

<div class="card">
    <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
        <h2 style="margin:0;">Orders (@Model.Orders.Count)</h2>
        <label class="muted" style="display:flex; align-items:center; gap:6px; cursor:pointer;">
            <input type="checkbox" id="autoRefresh" /> Auto-refresh (3s)
            <span id="refreshDot" style="width:8px;height:8px;border-radius:50%;background:#cbd5e1;display:inline-block;"></span>
        </label>
    </div>

    <div class="pills" style="margin:14px 0;">
        <a class="pill @(string.IsNullOrEmpty(region) ? "active" : "")" href="/Orders">All regions</a>
        @foreach (var r in regions)
        {
            <a class="pill @(region == r ? "active" : "")" href="/Orders?region=@r">@r</a>
        }
    </div>

    @if (Model.Orders.Count == 0)
    {
        <div class="empty">No orders@(string.IsNullOrEmpty(region) ? "" : $" in {region}") yet — submit one above.</div>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Order Id</th><th>Region</th><th>Customer</th><th>Product</th><th>Qty</th><th>Total</th><th>Status</th><th>Created</th></tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Orders)
                {
                    <tr>
                        <td><code>@o.OrderId[..8]</code></td>
                        <td>@o.Region</td>
                        <td>@o.CustomerName</td>
                        <td>@o.Product</td>
                        <td>@o.Quantity</td>
                        <td>@o.Total.ToString("C")</td>
                        <td>
                            @if (o.Status == "Processed")
                            { <span class="badge ok">✓ Processed</span> }
                            else
                            { <span class="badge pending">⏳ @o.Status</span> }
                        </td>
                        <td>@(o.Timestamp?.LocalDateTime.ToString("g") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<script>
    (function () {
        var box = document.getElementById('autoRefresh');
        var dot = document.getElementById('refreshDot');
        var KEY = 'orders-auto-refresh';
        var timer = null;

        function start() {
            dot.style.background = '#1a7f37';
            timer = setTimeout(function () { location.reload(); }, 3000);
        }
        function stop() {
            dot.style.background = '#cbd5e1';
            if (timer) { clearTimeout(timer); timer = null; }
        }
        try { box.checked = localStorage.getItem(KEY) === '1'; } catch (e) {}
        box.addEventListener('change', function () {
            try { localStorage.setItem(KEY, box.checked ? '1' : '0'); } catch (e) {}
            box.checked ? start() : stop();
        });
        if (box.checked) start();
    })();
</script>
